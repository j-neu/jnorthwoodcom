---
import { getCollection } from 'astro:content';
import Wave from './Wave.astro';

const entry = (await getCollection('site')).find((e) => e.id === 'expertise')!;
const { eyebrow, items, rotator } = entry.data;
---
<section id="expertise" class="expertise pinned">
  <Wave fill="#e5e5e1" />
  <div class="container">
    <div class="inner expertise-inner">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      {rotator && (
        <p class="sentence" data-rotator data-words={JSON.stringify(rotator.words)} data-reveal>
          {rotator.firstPart}{' '}
          <span class="rotator-word" style={`color:${rotator.words[0].color}`}>
            {rotator.words[0].word}
          </span>{' '}
          {rotator.secondPart}
        </p>
      )}      <div class="paragraphs">
        {items?.map((item, i) => (
          <p class="paragraph" data-reveal style={`--delay:${i * 150}ms`}>
            <strong>{item.name}.</strong> {item.body}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .expertise {
    background: #e5e5e1;
    color: var(--color-content-primary);
    padding: 6rem 0 28rem;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-content-secondary);
    margin: 0 0 1rem;
  }
  .sentence {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 4rem;
    line-height: 1.05;
    max-width: 24rem;
    margin: 0 0 12.5rem;
  }
  @media (min-width: 768px) {
    .sentence {
      font-size: 7vw;
      max-width: none;
      margin: 0 0 6rem;
    }
  }
  @media (min-width: 1200px) {
    .sentence { font-size: 5.25rem; }
  }
  .rotator-word {
    transition: opacity 0.75s linear;
  }
  .rotator-word--fade {
    opacity: 0;
  }
  .paragraphs {
    display: grid;
    gap: 3.75rem;
  }
  .paragraph {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.5rem;
    line-height: 1.2;
    margin: 0;
  }
  @media (min-width: 768px) {
    .paragraph { font-size: 3.75rem; width: 90%; }
  }
  .paragraph :global(strong) { font-weight: 500; }
</style>
