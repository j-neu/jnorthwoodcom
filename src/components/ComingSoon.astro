---
import { getCollection, render } from 'astro:content';
import Wave from './Wave.astro';

const entries = await getCollection('site');
const entry = entries.find((e) => e.id === 'coming-soon')!;
const { eyebrow, name } = entry.data;
const { Content } = await render(entry);
const footerEntry = entries.find((e) => e.id === 'footer')!;
const email = footerEntry.data.email;
---
<section id="coming-soon" class="coming pinned">
  <Wave fill="#f8f8f7" />
  <div class="container">
    <div class="inner coming-inner">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h2 class="title" data-reveal style="--delay:120ms">{name}</h2>
      <div class="prose" data-reveal style="--delay:200ms">
        <Content />
      </div>
      <div class="cta" data-reveal style="--delay:300ms">
        <a class="btn btn--primary" href={`mailto:${email}`}>
          Be notified
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .coming {
    background: var(--color-surface-light);
    color: var(--color-content-primary);
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem 0;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-content-secondary);
    margin: 0 0 1rem;
  }
  .title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 1.5rem;
  }
  .prose {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.45;
    max-width: 40rem;
    color: var(--color-content-secondary);
  }
  .prose :global(p) { margin: 0 0 2.5rem; }
  .cta { display: flex; }
</style>
